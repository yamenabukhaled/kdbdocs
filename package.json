{
  "name": "document-assistant",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e playwright.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests e2e playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "firebase": "13.3.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "fake-indexeddb": "6.2.8",
    "pdfkit": "0.20.2",
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
